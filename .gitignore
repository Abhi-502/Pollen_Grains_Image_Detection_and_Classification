# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Extracted weights / large binaries
*.h5
*.keras

# Uploaded user images (preserve directory)
flask/static/uploads/*
!flask/static/uploads/readme.me
!flask/static/uploads/.gitkeep

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
